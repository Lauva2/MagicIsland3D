  m_Script: {fileID: 11500000, guid: e2b4c0646f1b41718aa8c462ce6748f5, type: 3}
  m_Name: DialogueCatalog
  m_EditorClassIdentifier: 
  Dialogues:
  - NpcId: island_steward
    Intro:
    - "\u4F60\u597D\uFF0C\u6B22\u8FCE\u6765\u5230\u8FD9\u5EA7\u5C0F\u5C9B\uFF01\u6211\u662F\u6797\u821F\uFF0C\u8D1F\u8D23\u529E\u4E8B\u5904\u7684\u65E5\u5E38\u4E8B\u52A1\u3002"
    - "\u95E8\u524D\u7684\u516C\u544A\u680F\u4F1A\u53D1\u5E03\u6536\u8D2D\u8BA2\u5355\u3002\u51C6\u5907\u597D\u4F5C\u7269\u540E\uFF0C\u5C31\u6765\u8FD9\u91CC\u4EA4\u4ED8\u5427\u3002"
    - "\u7530\u5730\u3001\u6599\u7406\u53F0\u548C\u5DE5\u5177\u5DE5\u4F5C\u53F0\u90FD\u5DF2\u7ECF\u5907\u597D\u4E86\u3002\u6162\u6162\u6765\uFF0C\u627E\u5230\u81EA\u5DF1\u559C\u6B22\u7684\u751F\u6D3B\u8282\u594F\u3002"
    Repeat:
    - "\u53C8\u89C1\u9762\u4E86\uFF01\u4ECA\u5929\u7684\u5C9B\u5C7F\u751F\u6D3B\u8FD8\u987A\u5229\u5417\uFF1F"
    Seasons:
    - "\u6625\u5929\u5F88\u9002\u5408\u79CD\u829C\u83C1\u3002\u64AD\u79CD\u4EE5\u540E\u8BB0\u5F97\u6D47\u6C34\uFF0C\u6536\u6210\u4F1A\u6162\u6162\u957F\u8D77\u6765\u3002"
    - "\u590F\u5929\u53EF\u4EE5\u8BD5\u8BD5\u756A\u8304\u548C\u7389\u7C73\u3002\u8BB0\u5F97\u7559\u4E9B\u7389\u7C73\uFF0C\u70E4\u7740\u5403\u4E5F\u5F88\u9999\u3002"
    - "\u79CB\u5929\u80FD\u79CD\u829C\u83C1\u548C\u7389\u7C73\u3002\u628A\u591A\u4F59\u7684\u6536\u6210\u653E\u8FDB\u50A8\u7269\u7BB1\uFF0C\u51AC\u5929\u4E5F\u7528\u5F97\u4E0A\u3002"
    - "\u51AC\u5929\u53EF\u4EE5\u6574\u7406\u5E93\u5B58\u3001\u91C7\u96C6\u6750\u6599\u3002\u516C\u544A\u680F\u4ECD\u4F1A\u6536\u8D2D\u4F60\u4E4B\u524D\u7559\u4E0B\u7684\u4F5C\u7269\u3002"
    Weather:
    - "\u4ECA\u5929\u9633\u5149\u4E0D\u9519\uFF0C\u9002\u5408\u5728\u5C9B\u4E0A\u8D70\u8D70\u3002\u52B3\u4F5C\u7D2F\u4E86\uFF0C\u5C31\u5403\u70B9\u6599\u7406\u8865\u5145\u4F53\u529B\u3002"
    - "\u4ECA\u5929\u4E0B\u96E8\u4E86\uFF0C\u96E8\u6C34\u4F1A\u7167\u987E\u9732\u5929\u4F5C\u7269\u3002\u4E5F\u522B\u5FD8\u4E86\u5728\u50A8\u7269\u7BB1\u91CC\u7559\u4E9B\u5907\u7528\u6750\u6599\u3002"
